# Postgres (Neon). `neon link` / `neon deploy` fill these in automatically, or use the
# local docker container from `npm run db:start` with the URL below.
# App traffic: pooled endpoint (-pooler). Drizzle Kit / db:init: direct endpoint.
DATABASE_URL=postgres://root:mysecretpassword@localhost:5432/local
DATABASE_URL_UNPOOLED=postgres://root:mysecretpassword@localhost:5432/local
